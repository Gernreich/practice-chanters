{"commands":[
{"command":"parameters.add","params":{"name":"ply","expression":"3 mm","comment":"plate thickness: measure the ply, as the generator's --plate="}},
{"command":"parameters.add","params":{"name":"ref_bore","expression":"4.87 mm","comment":"the reference chanter's bore, whose area the octagon keeps"}},
{"command":"parameters.add","params":{"name":"bore_flats","expression":"ref_bore*sqrt(pi/(8*0.4142135623730951))","comment":"read only: the bore, an octagon, across its flats"}},
{"command":"parameters.add","params":{"name":"outer_flats","expression":"16 mm","comment":"the body's outside across its flats"}},
{"command":"parameters.add","params":{"name":"seat_d","expression":"5.57 mm","comment":"the reed's seat, through the seat plates"}},
{"command":"parameters.add","params":{"name":"n_seat","expression":"9","unit":"","comment":"seat plates"}},
{"command":"parameters.add","params":{"name":"n_bore","expression":"79","unit":"","comment":"bore plates, down to the open sole: the solver's whole number nearest the reference's low G"}},
{"command":"parameters.add","params":{"name":"bore_len","expression":"n_bore*ply","comment":"read only: the bore below the seat"}},
{"command":"parameters.add","params":{"name":"rod_hole","expression":"2.2 mm","comment":"the two M2 rods' holes, through the seat and the bore"}},
{"command":"parameters.add","params":{"name":"rod1_y","expression":"2.1084505254357344 mm","comment":"rod 1's place across the plate, toward the thumb (a search's)"}},
{"command":"parameters.add","params":{"name":"rod1_z","expression":"-5.218598176584667 mm","comment":"and up"}},
{"command":"parameters.add","params":{"name":"rod2_y","expression":"1.92503966448867 mm","comment":"rod 2's place across the plate, toward the thumb (a search's)"}},
{"command":"parameters.add","params":{"name":"rod2_z","expression":"5.289003009737126 mm","comment":"and up"}},
{"command":"parameters.add","params":{"name":"w_slot","expression":"1 mm","comment":"a hole narrower than this is drilled at a V, not cut as a slot"}},
{"command":"parameters.add","params":{"name":"v_w","expression":"1.2 mm","comment":"the drill mark's V, across"}},
{"command":"parameters.add","params":{"name":"v_d","expression":"0.6 mm","comment":"and deep"}},
{"command":"parameters.add","params":{"name":"pos_1","expression":"196.5 mm","comment":"the A hole's centre, down the bore from the seat: the solver's"}},
{"command":"parameters.add","params":{"name":"w_1","expression":"4.310386293745525 mm","comment":"its slot's width through one plate: the solver's"}},
{"command":"parameters.add","params":{"name":"drill_1","expression":"sqrt(4*w_1*ply/pi)","comment":"read only: the drill that gives the same area, where it is drilled"}},
{"command":"parameters.add","params":{"name":"x_1","expression":"(n_seat + floor(pos_1/ply + 1e-9))*ply","comment":"read only: the top of the plate it is cut in"}},
{"command":"parameters.add","params":{"name":"pos_2","expression":"163.5 mm","comment":"the B hole's centre, down the bore from the seat: the solver's"}},
{"command":"parameters.add","params":{"name":"w_2","expression":"3.604478596342935 mm","comment":"its slot's width through one plate: the solver's"}},
{"command":"parameters.add","params":{"name":"drill_2","expression":"sqrt(4*w_2*ply/pi)","comment":"read only: the drill that gives the same area, where it is drilled"}},
{"command":"parameters.add","params":{"name":"x_2","expression":"(n_seat + floor(pos_2/ply + 1e-9))*ply","comment":"read only: the top of the plate it is cut in"}},
{"command":"parameters.add","params":{"name":"pos_3","expression":"139.5 mm","comment":"the C hole's centre, down the bore from the seat: the solver's"}},
{"command":"parameters.add","params":{"name":"w_3","expression":"4.371009183961865 mm","comment":"its slot's width through one plate: the solver's"}},
{"command":"parameters.add","params":{"name":"drill_3","expression":"sqrt(4*w_3*ply/pi)","comment":"read only: the drill that gives the same area, where it is drilled"}},
{"command":"parameters.add","params":{"name":"x_3","expression":"(n_seat + floor(pos_3/ply + 1e-9))*ply","comment":"read only: the top of the plate it is cut in"}},
{"command":"parameters.add","params":{"name":"pos_4","expression":"112.5 mm","comment":"the D hole's centre, down the bore from the seat: the solver's"}},
{"command":"parameters.add","params":{"name":"w_4","expression":"3.3711764979464296 mm","comment":"its slot's width through one plate: the solver's"}},
{"command":"parameters.add","params":{"name":"drill_4","expression":"sqrt(4*w_4*ply/pi)","comment":"read only: the drill that gives the same area, where it is drilled"}},
{"command":"parameters.add","params":{"name":"x_4","expression":"(n_seat + floor(pos_4/ply + 1e-9))*ply","comment":"read only: the top of the plate it is cut in"}},
{"command":"parameters.add","params":{"name":"pos_5","expression":"88.5 mm","comment":"the E hole's centre, down the bore from the seat: the solver's"}},
{"command":"parameters.add","params":{"name":"w_5","expression":"3.9811805605867376 mm","comment":"its slot's width through one plate: the solver's"}},
{"command":"parameters.add","params":{"name":"drill_5","expression":"sqrt(4*w_5*ply/pi)","comment":"read only: the drill that gives the same area, where it is drilled"}},
{"command":"parameters.add","params":{"name":"x_5","expression":"(n_seat + floor(pos_5/ply + 1e-9))*ply","comment":"read only: the top of the plate it is cut in"}},
{"command":"parameters.add","params":{"name":"pos_6","expression":"64.5 mm","comment":"the F hole's centre, down the bore from the seat: the solver's"}},
{"command":"parameters.add","params":{"name":"w_6","expression":"3.4192865409705804 mm","comment":"its slot's width through one plate: the solver's"}},
{"command":"parameters.add","params":{"name":"drill_6","expression":"sqrt(4*w_6*ply/pi)","comment":"read only: the drill that gives the same area, where it is drilled"}},
{"command":"parameters.add","params":{"name":"x_6","expression":"(n_seat + floor(pos_6/ply + 1e-9))*ply","comment":"read only: the top of the plate it is cut in"}},
{"command":"parameters.add","params":{"name":"pos_7","expression":"43.5 mm","comment":"the G hole's centre, down the bore from the seat: the solver's"}},
{"command":"parameters.add","params":{"name":"w_7","expression":"2.7341820377424835 mm","comment":"its slot's width through one plate: the solver's"}},
{"command":"parameters.add","params":{"name":"drill_7","expression":"sqrt(4*w_7*ply/pi)","comment":"read only: the drill that gives the same area, where it is drilled"}},
{"command":"parameters.add","params":{"name":"x_7","expression":"(n_seat + floor(pos_7/ply + 1e-9))*ply","comment":"read only: the top of the plate it is cut in"}},
{"command":"parameters.add","params":{"name":"pos_8","expression":"31.5 mm","comment":"the hA hole's centre, down the bore from the seat: the solver's"}},
{"command":"parameters.add","params":{"name":"w_8","expression":"2.6161838610744645 mm","comment":"its slot's width through one plate: the solver's"}},
{"command":"parameters.add","params":{"name":"drill_8","expression":"sqrt(4*w_8*ply/pi)","comment":"read only: the drill that gives the same area, where it is drilled"}},
{"command":"parameters.add","params":{"name":"x_8","expression":"(n_seat + floor(pos_8/ply + 1e-9))*ply","comment":"read only: the top of the plate it is cut in"}},
{"command":"parameters.add","params":{"name":"cap_clear","expression":"0.3 mm","comment":"the socket's clearance each side of the body, for hemp or tape"}},
{"command":"parameters.add","params":{"name":"cap_web","expression":"2 mm","comment":"ply each side of the cap's pins"}},
{"command":"parameters.add","params":{"name":"pin","expression":"2 mm","comment":"the cap's brass pins"}},
{"command":"parameters.add","params":{"name":"pin_interf","expression":"0.1 mm","comment":"their holes this much under the pin, a press-fit"}},
{"command":"parameters.add","params":{"name":"n_socket","expression":"5","unit":"","comment":"socket plates, over the body's top"}},
{"command":"parameters.add","params":{"name":"n_chamber","expression":"12","unit":"","comment":"chamber plates, round the reed's blades"}},
{"command":"parameters.add","params":{"name":"n_top","expression":"2","unit":"","comment":"the cap's top plates"}},
{"command":"parameters.add","params":{"name":"chamber_d","expression":"13 mm","comment":"the chamber round the reed"}},
{"command":"parameters.add","params":{"name":"mouth_d","expression":"4.5 mm","comment":"the blowing hole"}},
{"command":"parameters.add","params":{"name":"sock_flats","expression":"outer_flats + 2*cap_clear","comment":"read only: the socket across its flats"}},
{"command":"parameters.add","params":{"name":"cap_flats","expression":"sock_flats + 2*(2*cap_web + pin)","comment":"read only: the cap across its flats"}},
{"command":"parameters.add","params":{"name":"pin_r","expression":"(sock_flats/2 + cap_web + pin/2)/0.9238795325112867","comment":"read only: the pins' distance from the axis, at two opposite corners"}},
{"command":"parameters.add","params":{"name":"cap_top","expression":"-(n_chamber + n_top)*ply","comment":"read only: the cap's top, where the mouthpiece starts"}},
{"command":"sketch.create","params":{"plane":{"origin":[0,0,0],"x_dir":[0,1,0],"y_dir":[0,0,1]},"offset":"0 mm","name":"seat plate sketch"}},
