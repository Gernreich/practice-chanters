# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# The generators are Rust (repro-svg builds the crate first) and name their
# own sheets, so each writes into $OUT's directory and the tool compares the
# file it asked for. The crate builds on square-flute, four-hole-ocarinas,
# swept-curve, bore-tmm and lasermade-tools, so all are expected checked out
# side by side.

# --- the cut files, one sheet a design ---
cut-files/practice-chanter-8-sided-sheet1-cut-files.svg :: target/release/practice_chanters --out=$(dirname $OUT)
cut-files/practice-chanter-strips-finger-joint-sheet1-cut-files.svg :: target/release/strip_chanter --out=$(dirname $OUT)
cut-files/practice-chanter-strips-butt-joint-sheet1-cut-files.svg :: target/release/strip_chanter --joint=butt --out=$(dirname $OUT)
cut-files/practice-chanter-standard-strips-finger-joint-sheet1-cut-files.svg :: target/release/standard_chanter --out=$(dirname $OUT)
cut-files/practice-chanter-standard-strips-butt-joint-sheet1-cut-files.svg :: target/release/standard_chanter --joint=butt --out=$(dirname $OUT)
cut-files/practice-chanter-standard-octagon-sheet1-cut-files.svg :: target/release/standard_octagon --out=$(dirname $OUT)

# --- the previews, from the cut files ---
previews/practice-chanter-8-sided-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/practice-chanter-8-sided-sheet1-cut-files.svg $OUT
previews/practice-chanter-strips-finger-joint-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/practice-chanter-strips-finger-joint-sheet1-cut-files.svg $OUT
previews/practice-chanter-strips-butt-joint-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/practice-chanter-strips-butt-joint-sheet1-cut-files.svg $OUT
previews/practice-chanter-standard-strips-finger-joint-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/practice-chanter-standard-strips-finger-joint-sheet1-cut-files.svg $OUT
previews/practice-chanter-standard-strips-butt-joint-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/practice-chanter-standard-strips-butt-joint-sheet1-cut-files.svg $OUT
previews/practice-chanter-standard-octagon-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/practice-chanter-standard-octagon-sheet1-cut-files.svg $OUT

# --- the pages ---
turn.html :: target/release/practice_chanters --page-to=$OUT
index.html :: ../lasermade-tools/target/release/md2html README.md $OUT

# --- the SolidCraft designs: each script, its design (slimmed by sc-slim so it
# is the same every run), and the STEP file SolidCraft builds from it ---
solidcraft/practice-chanters-standard.solidcraft.json :: target/release/practice_chanters --solidcraft=$(dirname $OUT)
solidcraft/practice-chanters-standard.sc :: target/release/practice_chanters --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/practice-chanters-standard.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
step/practice-chanters-standard.step :: target/release/practice_chanters --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/practice-chanters-standard.solidcraft.json --out $OUT --quiet
solidcraft/practice-chanters-standard-octagon.solidcraft.json :: target/release/practice_chanters --solidcraft=$(dirname $OUT)
solidcraft/practice-chanters-standard-octagon.sc :: target/release/practice_chanters --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/practice-chanters-standard-octagon.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
step/practice-chanters-standard-octagon.step :: target/release/practice_chanters --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/practice-chanters-standard-octagon.solidcraft.json --out $OUT --quiet
solidcraft/practice-chanters-stacked-octagon.solidcraft.json :: target/release/practice_chanters --solidcraft=$(dirname $OUT)
solidcraft/practice-chanters-stacked-octagon.sc :: target/release/practice_chanters --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/practice-chanters-stacked-octagon.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
step/practice-chanters-stacked-octagon.step :: target/release/practice_chanters --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/practice-chanters-stacked-octagon.solidcraft.json --out $OUT --quiet
